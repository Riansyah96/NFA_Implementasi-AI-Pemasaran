    },
    {
      "parameters": {
        "jsCode": "const output = [];\nconst now = DateTime.now().setZone('Asia/Jakarta');\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const status = data['Status'];\n  const scheduledDate = data['Scheduled Date'];\n  const scheduledTime = data['Scheduled Time'];\n\n  // Skip jika Status kosong atau bukan 'pending'\n  if (!status || status.toString().trim() === '' || status.toString().toLowerCase().trim() !== 'pending') {\n    continue;\n  }\n\n  if (!scheduledDate || !scheduledTime) continue;\n\n  const dateStr = scheduledDate.toString().trim();\n  const timeStr = scheduledTime.toString().trim();\n\n  // Coba dd/MM/yyyy DULU (karena locale Indonesia)\n  let scheduledDT = DateTime.fromFormat(`${dateStr} ${timeStr}`, 'dd/MM/yyyy H:mm:ss', { zone: 'Asia/Jakarta' });\n  if (!scheduledDT.isValid) {\n    scheduledDT = DateTime.fromFormat(`${dateStr} ${timeStr}`, 'dd/MM/yyyy HH:mm:ss', { zone: 'Asia/Jakarta' });\n  }\n  if (!scheduledDT.isValid) {\n    scheduledDT = DateTime.fromFormat(`${dateStr} ${timeStr}`, 'dd/MM/yyyy H:mm', { zone: 'Asia/Jakarta' });\n  }\n  if (!scheduledDT.isValid) {\n    scheduledDT = DateTime.fromFormat(`${dateStr} ${timeStr}`, 'MM/dd/yyyy H:mm:ss', { zone: 'Asia/Jakarta' });\n  }\n\n  if (!scheduledDT.isValid) continue;\n\n  if (scheduledDT <= now) {\n    output.push({\n      json: {\n        ...data,\n        row_number: data.row_number || item.json.row_number\n      }\n    });\n  }\n}\n\nreturn output;"
      },
