      "parameters": {
        "jsCode": "// Binary (hasil download Telegram) -> string Base64 untuk upload ke KIE.ai\nconst item = $input.first();\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst mime = (item.binary && item.binary.data && item.binary.data.mimeType) || 'image/jpeg';\nreturn [{ json: {\n  base64Data: `data:${mime};base64,${buffer.toString('base64')}`,\n  uploadPath: 'n8n/telegram',\n  fileName: `telegram_${Date.now()}.jpg`\n} }];"
      },
