    {
      "parameters": {
        "jsCode": "const createResp = $('KIE Create Video Task').first().json;\nconst getResp =$input.first().json;\n\n// 1. Cek jika saldo KIE.ai habis saat pembuatan task (Error 402)\nif (createResp.code === 402 || (createResp.msg && createResp.msg.includes('Credits insufficient'))) {\n  throw new Error('Gagal: Saldo / Credits KIE.ai habis. Silakan top-up terlebih dahulu.');\n}\n\n// 2. Cek jika taskId tidak terbentuk\nif (!createResp.data || !createResp.data.taskId) {\n  throw new Error('Gagal: Task ID tidak valid / tidak ditemukan.');\n}\n\n// 3. Cek status pengerjaan video dari KIE Get Video Status\nconst d = getResp.data || {};\nif (d.state === 'fail') {\n  throw new Error('KIE.ai gagal membuat video: ' + (d.failMsg || 'unknown'));\n}\n\nreturn [{ json: { state: d.state, resultJson: d.resultJson || null } }];"
      },
