    {
      "parameters": {
        "jsCode": "// ===== LANGKAH 2: Hitung Engagement Score =====\n// Bobot: Like x1, Comment x2, Share x3 (silakan ubah di sini)\nconst BOBOT = { likes: 1, comments: 2, shares: 3 };\n\nfunction hitungEngagementScore(post) {\n  const likes = Number(post['Likes']) || 0;\n  const comments = Number(post['Comments']) || 0;\n  const shares = Number(post['Shares']) || 0;\n  return (likes * BOBOT.likes) + (comments * BOBOT.comments) + (shares * BOBOT.shares);\n}\n\nconst hasil = [];\nfor (const item of $input.all()) {\n  const p = item.json;\n  const jam = parseInt(String(p['Jam Posting']).trim(), 10);\n  if (isNaN(jam) || jam < 0 || jam > 23) continue; // lewati baris kosong / tidak valid\n\n  hasil.push({\n    json: {\n      tanggal: p['Tanggal Posting'],\n      jam: jam,\n      platform: p['Platform'],\n      likes: Number(p['Likes']) || 0,\n      comments: Number(p['Comments']) || 0,\n      shares: Number(p['Shares']) || 0,\n      engagementScore: hitungEngagementScore(p)\n    }\n  });\n}\nreturn hasil;"
      },
      "id": "8c2eab9b-014f-4936-b6b4-b00c3e3b6fd2",
      "name": "Hitung Engagement Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===== LANGKAH 3: Agregasi rata-rata engagement per jam & ambil Top 5 =====\nconst perJam = {};\nfor (const item of $input.all()) {\n  const { jam, engagementScore } = item.json;\n  if (!perJam[jam]) perJam[jam] = { total: 0, jumlah: 0 };\n  perJam[jam].total += engagementScore;\n  perJam[jam].jumlah += 1;\n}\n\nconst pad = (n) => String(n).padStart(2, '0');\n\nconst top5 = Object.entries(perJam)\n  .map(([jam, v]) => ({\n    jam: Number(jam),\n    jamLabel: pad(jam) + ':00',\n    rataEngagement: Math.round((v.total / v.jumlah) * 100) / 100,\n    jumlahPosting: v.jumlah\n  }))\n  .sort((a, b) => b.rataEngagement - a.rataEngagement) // urut dari tertinggi\n  .slice(0, 5)\n  .map((x, i) => ({ peringkat: i + 1, ...x }));\n\nconst tanggalAnalisis = new Date().toLocaleDateString('id-ID', {\n  timeZone: 'Asia/Jakarta', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'\n});\n\nreturn [{ json: { tanggalAnalisis, totalPostingDianalisis: $input.all().length, top5 } }];"
      },
      "id": "9d58d0e7-d1d4-4a03-b671-67c18b1974a8",
      "name": "Agregasi per Jam (Top 5)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ]
    },
