    {
      "parameters": {
        "jsCode": "// ===== LANGKAH 5: Format pesan Telegram (HTML: <b> = bold) =====\nconst data = $('Agregasi per Jam (Top 5)').first().json;\nconst medali = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'];\n\nlet pesan = '📊 <b>LAPORAN HARIAN: JAM TERBAIK POSTING</b> 📊\\n';\npesan += '📅 ' + data.tanggalAnalisis + '\\n';\npesan += '━━━━━━━━━━━━━━━━━━\\n\\n';\npesan += '🏆 <b>Top 5 Jam Paling Engaging:</b>\\n\\n';\n\nfor (const x of data.top5) {\n  pesan += medali[x.peringkat - 1] + ' <b>Pukul ' + x.jamLabel + ' WIB</b>\\n';\n  pesan += '     🔥 Rata-rata skor: <b>' + x.rataEngagement + '</b>  (' + x.jumlahPosting + ' post)\\n\\n';\n}\n\npesan += '━━━━━━━━━━━━━━━━━━\\n';\npesan += '💡 <b>Rekomendasi:</b> Jadwalkan konten utama pukul <b>' + data.top5[0].jamLabel + '</b> untuk jangkauan maksimal!\\n';\npesan += '🧮 <i>Skor = Likes×1 + Comments×2 + Shares×3</i>\\n';\npesan += '📈 Total data dianalisis: ' + data.totalPostingDianalisis + ' postingan';\n\nreturn [{ json: { pesan } }];"
      },
