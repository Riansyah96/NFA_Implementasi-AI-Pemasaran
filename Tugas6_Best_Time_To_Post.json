        "jsCode": "// Siapkan 5 baris untuk ditulis ke sheet 'Hasil Analisis' (setelah Clear)\nconst data = $('Agregasi per Jam (Top 5)').first().json;\nreturn data.top5.map(x => ({\n  json: {\n    'Peringkat': x.peringkat,\n    'Jam': x.jamLabel,\n    'Rata-rata Engagement': x.rataEngagement,\n    'Jumlah Postingan': x.jumlahPosting,\n    'Tanggal Analisis': data.tanggalAnalisis\n  }\n}));"
