    {
      "parameters": {
        "jsCode": "// Format: /start 2026-10-20 tema kopi   (tanggal opsional, default hari ini WIB)\nconst msg = $input.first().json.message;\nconst chatId = msg.chat.id;\nlet raw = (msg.text || '').replace(/^\\/start(@\\w+)?/i, '').trim();\nlet tanggal = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });\nconst m = raw.match(/(\\d{4}-\\d{2}-\\d{2})|(\\d{1,2})[\\/-](\\d{1,2})[\\/-](\\d{4})/);\nif (m) {\n  tanggal = m[1] ? m[1] : `${m[4]}-${m[3].padStart(2, '0')}-${m[2].padStart(2, '0')}`;\n  raw = raw.replace(m[0], '').trim();\n}\nconst tema = raw || 'Umum';\nreturn [{ json: { chatId, tanggal, tema } }];"
      },
      "id": "ddd9fa8f-1f5a-4db1-8c1a-988c368eb861",
      "name": "Parse Tanggal & Tema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        1104
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Buatkan rencana konten harian untuk tanggal {{ $json.tanggal }} dengan tema \"{{ $json.tema }}\".\nBuat 6 slot waktu (WIB) dari pagi sampai malam. Setiap slot berisi time_slot (format \"HH:MM - HH:MM\"), title (judul ide konten yang menarik dan spesifik) dan focus (fokus/tujuan konten dalam 1 kalimat).",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Kamu adalah content strategist media sosial berbahasa Indonesia. Jawab HANYA dalam format JSON sesuai skema yang diminta, tanpa teks tambahan."
            }
          ]
        }
      },
