    {
      "parameters": {
        "jsCode": "// Binary -> Base64 -> Buffer -> binary n8n (nama file & mimetype dinormalisasi agar diterima Telegram)\nconst src = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = src.toString('base64');            // Buffer -> Base64\nconst buffer = Buffer.from(base64, 'base64');     // Base64 -> Buffer\nconst binary = await this.helpers.prepareBinaryData(buffer, 'video.mp4', 'video/mp4');\nreturn [{ json: { sizeKB: Math.round(buffer.length / 1024) }, binary: { data: binary } }];"
      },
