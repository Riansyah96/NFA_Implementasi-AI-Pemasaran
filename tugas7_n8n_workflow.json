    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output;\nconst rencana = out.rencana || [];\nlet teks = `📅 Rencana Konten ${out.tanggal}\\n🎯 Tema: ${out.tema}\\n\\n`;\nrencana.forEach((r, i) => {\n  teks += `${i + 1}. ⏰ ${r.time_slot}\\n   ${r.title}\\n   Fokus: ${r.focus}\\n\\n`;\n});\nteks += '👉 Kirim judul ide pilihanmu sebagai teks biasa untuk dibuatkan gambar.\\n🎬 Kirim gambar dengan caption \"video\" untuk dijadikan animasi.';\nreturn [{ json: { chatId: $('Parse Tanggal & Tema').first().json.chatId, teks, rencana } }];"
      },
