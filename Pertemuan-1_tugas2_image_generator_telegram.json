    {
      "parameters": {
        "jsCode": "// Parsing respons JSON dan ekstrak URL gambar yang valid\nconst data = $input.first().json.data || {};\nlet result = data.resultJson;\n\n// resultJson biasanya berupa string JSON, ubah menjadi objek\nif (typeof result === 'string') {\n  try {\n    result = JSON.parse(result);\n  } catch (e) {\n    throw new Error('Gagal parsing resultJson: ' + e.message);\n  }\n}\n\nconst urls = (result && Array.isArray(result.resultUrls)) ? result.resultUrls : [];\n\n// Validasi: hanya URL http/https yang valid\nconst validUrls = urls.filter(u => typeof u === 'string' && /^https?:\\/\\/\\S+$/i.test(u.trim())).map(u => u.trim());\n\nif (validUrls.length === 0) {\n  throw new Error('Tidak ada URL gambar yang valid pada hasil API');\n}\n\nreturn [\n  {\n    json: {\n      taskId: data.taskId,\n      imageUrl: validUrls[0],\n      allUrls: validUrls\n    }\n  }\n];"
      },
      "id": "2663c9fe-e1e1-4648-8df7-8f7280468db2",
